/* ════════════════════════════════════════════════════════════
 * lcd_i2c.c — implementation
 * ════════════════════════════════════════════════════════════ */

#include "lcd_i2c.h"

/* ── Khai báo API của I2C driver bạn đã viết ───────────────
 * Prototype phải khớp với hàm trong i2c.h của bạn */
extern uint8_t I2Cx_Write(I2C_TypeDef *I2Cx,
                           uint8_t addrSlave,
                           uint8_t addrReg,
                           uint8_t *data,
                           uint8_t size);

/* ── Biến lưu trạng thái backlight ─────────────────────────
 * Cần giữ bit BL khi gửi data để đèn không tắt */
static uint8_t s_backlight = LCD_BL;   /* mặc định: bật */

/* ════════════════════════════════════════════════════════════
 * Tầng thấp nhất: gửi 1 byte xuống PCF8574
 *
 * PCF8574 không có "register" — byte đầu tiên sau ADDR là
 * trực tiếp trạng thái 8 GPIO. Vì vậy ta dùng I2Cx_Write
 * với addrReg=byte cần gửi và size=0 (không có data thêm).
 *
 * Thực ra API của bạn gửi: START → ADDR → addrReg → data[0..n] → STOP
 * Với PCF8574 ta chỉ cần gửi 1 byte sau ADDR là đủ.
 * → addrReg = byte điều khiển, size = 0, data = NULL/ignored
 * ════════════════════════════════════════════════════════════ */
static void pcf8574_write(I2C_TypeDef *I2Cx, uint8_t byte)
{
    /* I2Cx_Write gửi: START → ADDR → addrReg → [data×size] → STOP
     * PCF8574 chỉ cần 1 byte sau địa chỉ → addrReg=byte, size=0 */
    I2Cx_Write(I2Cx, LCD_I2C_ADDR, byte, NULL, 0);
}

/* ════════════════════════════════════════════════════════════
 * EN pulse: LCD chốt data tại cạnh xuống của EN
 * Sequence: byte | EN → delay → byte & ~EN → delay
 * HD44780 datasheet: EN pulse width min 450ns, cycle min 1µs
 * ════════════════════════════════════════════════════════════ */
static void lcd_pulse_en(I2C_TypeDef *I2Cx, uint8_t byte)
{
    pcf8574_write(I2Cx, byte | LCD_EN);           /* EN = 1 */
    HAL_Delay(1);                                  /* >450 ns */
    pcf8574_write(I2Cx, byte & (uint8_t)~LCD_EN); /* EN = 0 → LCD chốt */
    HAL_Delay(1);                                  /* >37 µs settle */
}

/* ════════════════════════════════════════════════════════════
 * Gửi 1 nibble (4 bit) xuống LCD
 * nibble: giá trị 4-bit đặt vào D7–D4 (bit 7–4 của PCF8574)
 * rs    : LCD_RS (data) hoặc 0 (command)
 * ════════════════════════════════════════════════════════════ */
static void lcd_send_nibble(I2C_TypeDef *I2Cx, uint8_t nibble, uint8_t rs)
{
    /* Ghép nibble vào D7–D4, giữ BL, set RS */
    uint8_t byte = (nibble & 0xF0U) | s_backlight | rs;
    lcd_pulse_en(I2Cx, byte);
}

/* ════════════════════════════════════════════════════════════
 * Gửi 1 byte đầy đủ xuống LCD (2 nibble: cao trước, thấp sau)
 * rs: LCD_RS (character data) hoặc 0 (command)
 * ════════════════════════════════════════════════════════════ */
static void lcd_send_byte(I2C_TypeDef *I2Cx, uint8_t byte, uint8_t rs)
{
    lcd_send_nibble(I2Cx, byte & 0xF0U,          rs); /* nibble cao */
    lcd_send_nibble(I2Cx, (byte << 4) & 0xF0U,   rs); /* nibble thấp */
}

static void lcd_send_cmd(I2C_TypeDef *I2Cx, uint8_t cmd)
{
    lcd_send_byte(I2Cx, cmd, 0);       /* RS=0: command */
}

static void lcd_send_data(I2C_TypeDef *I2Cx, uint8_t data)
{
    lcd_send_byte(I2Cx, data, LCD_RS); /* RS=1: character */
}

/* ════════════════════════════════════════════════════════════
 * LCD_Init
 * HD44780 datasheet §8 — Initializing by Instruction (4-bit)
 * Phải làm đúng sequence này — không thể bỏ qua bước nào
 * ════════════════════════════════════════════════════════════ */
void LCD_Init(I2C_TypeDef *I2Cx)
{
    /* Chờ LCD power-up: HD44780 cần >40ms sau khi VCC đạt 2.7V */
    HAL_Delay(50);

    /* Bật backlight ngay từ đầu */
    pcf8574_write(I2Cx, s_backlight);
    HAL_Delay(1);

    /* ── Bước 1–3: 3 lần gửi nibble 0x3 (reset sequence)
     * HD44780 datasheet Figure 24 — bắt buộc để đưa LCD
     * về trạng thái biết (dù trước đó đang ở 4-bit hay 8-bit) */
    lcd_send_nibble(I2Cx, 0x30U, 0);   /* Function Set: 8-bit (lần 1) */
    HAL_Delay(5);                        /* >4.1ms */

    lcd_send_nibble(I2Cx, 0x30U, 0);   /* Function Set: 8-bit (lần 2) */
    HAL_Delay(1);                        /* >100µs */

    lcd_send_nibble(I2Cx, 0x30U, 0);   /* Function Set: 8-bit (lần 3) */
    HAL_Delay(1);

    /* ── Bước 4: Chuyển sang 4-bit mode ───────────────────── */
    lcd_send_nibble(I2Cx, 0x20U, 0);   /* Function Set: switch to 4-bit */
    HAL_Delay(1);

    /* Từ đây trở đi tất cả gửi bằng 2 nibble (lcd_send_cmd) */

    /* ── Bước 5: Function Set — 4-bit, 2 dòng, 5×8 font ──── */
    lcd_send_cmd(I2Cx, LCD_CMD_4BIT_2LINE);
    HAL_Delay(1);

    /* ── Bước 6: Display OFF ─────────────────────────────── */
    lcd_send_cmd(I2Cx, LCD_CMD_DISPLAY_OFF);
    HAL_Delay(1);

    /* ── Bước 7: Clear Display ───────────────────────────── */
    lcd_send_cmd(I2Cx, LCD_CMD_CLEAR);
    HAL_Delay(2);   /* Clear cần >1.52ms */

    /* ── Bước 8: Entry Mode Set ──────────────────────────── */
    lcd_send_cmd(I2Cx, LCD_CMD_ENTRY_MODE);   /* cursor tăng, no shift */
    HAL_Delay(1);

    /* ── Bước 9: Display ON ──────────────────────────────── */
    lcd_send_cmd(I2Cx, LCD_CMD_DISPLAY_ON);
    HAL_Delay(1);
}

/* ════════════════════════════════════════════════════════════
 * LCD_Clear
 * ════════════════════════════════════════════════════════════ */
void LCD_Clear(I2C_TypeDef *I2Cx)
{
    lcd_send_cmd(I2Cx, LCD_CMD_CLEAR);
    HAL_Delay(2);   /* HD44780 cần >1.52ms để xử lý clear */
}

/* ════════════════════════════════════════════════════════════
 * LCD_SetCursor
 * DDRAM address = row_base + col
 * Lệnh Set DDRAM Address = 0x80 | address (HD44780 datasheet §8)
 * ════════════════════════════════════════════════════════════ */
void LCD_SetCursor(I2C_TypeDef *I2Cx, uint8_t col, uint8_t row)
{
    static const uint8_t row_addr[] = {
        LCD_ROW0_ADDR,
        LCD_ROW1_ADDR,
        LCD_ROW2_ADDR,
        LCD_ROW3_ADDR
    };

    if (row >= LCD_ROWS) row = LCD_ROWS - 1U;
    if (col >= LCD_COLS) col = LCD_COLS - 1U;

    lcd_send_cmd(I2Cx, 0x80U | (row_addr[row] + col));
}

/* ════════════════════════════════════════════════════════════
 * LCD_WriteChar
 * ════════════════════════════════════════════════════════════ */
void LCD_WriteChar(I2C_TypeDef *I2Cx, char c)
{
    lcd_send_data(I2Cx, (uint8_t)c);
}

/* ════════════════════════════════════════════════════════════
 * LCD_WriteString
 * ════════════════════════════════════════════════════════════ */
void LCD_WriteString(I2C_TypeDef *I2Cx, const char *str)
{
    while (*str) {
        lcd_send_data(I2Cx, (uint8_t)*str);
        str++;
    }
}

/* ════════════════════════════════════════════════════════════
 * LCD_Printf
 * ════════════════════════════════════════════════════════════ */
void LCD_Printf(I2C_TypeDef *I2Cx, const char *fmt, ...)
{
    char buf[LCD_COLS + 1U];
    va_list args;
    va_start(args, fmt);
    vsnprintf(buf, sizeof(buf), fmt, args);
    va_end(args);
    LCD_WriteString(I2Cx, buf);
}

/* ════════════════════════════════════════════════════════════
 * LCD_Backlight
 * ════════════════════════════════════════════════════════════ */
void LCD_Backlight(I2C_TypeDef *I2Cx, uint8_t on)
{
    s_backlight = on ? LCD_BL : 0U;
    /* Gửi byte chỉ chứa backlight bit để cập nhật ngay */
    pcf8574_write(I2Cx, s_backlight);
}

/* ════════════════════════════════════════════════════════════
 * LCD_DisplayOn / Off
 * ════════════════════════════════════════════════════════════ */
void LCD_DisplayOn(I2C_TypeDef *I2Cx)
{
    lcd_send_cmd(I2Cx, LCD_CMD_DISPLAY_ON);
}

void LCD_DisplayOff(I2C_TypeDef *I2Cx)
{
    lcd_send_cmd(I2Cx, LCD_CMD_DISPLAY_OFF);
}

/* ════════════════════════════════════════════════════════════
 * LCD_CreateChar — ghi custom character vào CGRAM
 * HD44780 datasheet §8: Set CGRAM Address = 0x40 | (slot<<3)
 * Sau đó ghi 8 byte pattern, rồi về DDRAM bằng SetCursor
 * ════════════════════════════════════════════════════════════ */
void LCD_CreateChar(I2C_TypeDef *I2Cx, uint8_t slot, const uint8_t *pattern)
{
    if (slot > 7U) return;

    /* Trỏ vào CGRAM */
    lcd_send_cmd(I2Cx, 0x40U | ((slot & 0x07U) << 3));

    /* Ghi 8 hàng pixel */
    for (uint8_t i = 0; i < 8U; i++) {
        lcd_send_data(I2Cx, pattern[i] & 0x1FU);  /* chỉ 5 bit thấp */
    }

    /* Về lại DDRAM (tránh tiếp tục ghi nhầm vào CGRAM) */
    LCD_SetCursor(I2Cx, 0, 0);
}
