#include "i2c.h"

void I2Cx_init(I2C_TypeDef *I2Cx, Pins_I2C pins, uint32_t speed)
{
	uint32_t PCLKx = HAL_RCC_GetPCLK1Freq(); // đều là PCLK1 cả 2 i2c
	uint32_t freq = 0;

	// 1. Enable clock
	RCC->APB2ENR |=  1 << 0; // AFIO
	if(I2Cx == I2C1) {
		RCC->APB1ENR |= 1 << 21; // i2c1 clock
	}
	if (I2Cx == I2C2) {
		RCC->APB1ENR |= 1 << 22; // i2c2 clock
	}

	if(pins == Pin_PB6PB7)  // pins i2c1
	{
		GPIOx_Init(GPIOB, 6, OUTPUT_AF_OD, NOPULL, MODE_OUTPUT_50MHZ); // SCL
		GPIOx_Init(GPIOB, 7, OUTPUT_AF_OD, NOPULL, MODE_OUTPUT_50MHZ);// SDA
	}

	if(pins == Pin_PB8PB9)  // pins i2c1
	{
		AFIO->MAPR |= AFIO_MAPR_I2C1_REMAP;
		GPIOx_Init(GPIOB, 8, OUTPUT_AF_OD, NOPULL, MODE_OUTPUT_50MHZ);
		GPIOx_Init(GPIOB, 9, OUTPUT_AF_OD, NOPULL, MODE_OUTPUT_50MHZ);
	}

	if(pins == Pin_PB10PB11)  // pins i2c2
	{
		GPIOx_Init(GPIOB, 10, OUTPUT_AF_OD, NOPULL, MODE_OUTPUT_50MHZ);
		GPIOx_Init(GPIOB, 11, OUTPUT_AF_OD, NOPULL, MODE_OUTPUT_50MHZ);
	}

	I2Cx->CR1 |= (0 << 10); // ACK
	I2Cx->CR2 &= ~(0x1f << 0);
	I2Cx->CR2 |= PCLKx / 1000000; // 36Mhz

	I2Cx->CR1 |= (0 << 1) | (1 << 0); // I2C mode EN
	I2Cx->CCR = 0; // sm mode i2c : duty cycle / 2

	I2Cx->CCR |= PCLKx / (2*speed);
	I2Cx->TRISE |= (PCLKx/1000000) + 1;
}

void I2Cx_Read(I2C_TypeDef *I2Cx, uint8_t addrSlave, uint8_t addrReg, uint8_t* data, uint8_t size) {
	I2Cx->CR1 |= (1 << 8) | (1 << 10); // ACK enable + Start generation
	while((I2Cx->SR1 & (1 << 0)) == 0); // Start generation

	I2Cx->DR = (addrSlave << 1) | 0;
	while(!(I2Cx->SR1 & (1 << 1)) | !(I2Cx->SR2 & (1 << 1))); // End of address transmission

	I2Cx->DR = addrReg;
	while(!(I2Cx->SR1 & (1 << 7))); // TxE : Data register empty (transmitters)

	//==================================================================================
	I2Cx->CR1 |= (1 << 8) | (1 << 10); // ACK enable + Start generation
	while((I2Cx->SR1 & (1 << 0)) == 0); // Start generation

	I2Cx->DR = (addrSlave << 1) | 1;
	while(!(I2Cx->SR1 & (1 << 1)) | !(I2Cx->SR2 & (1 << 1))); // End of address transmission

	if (size > 1) {
		for(int i=0; i < size-1; i++) {
			while(!(I2Cx->SR1 & (1 << 6))); // RxE
			data[i] = I2Cx->DR;
		}
	}

	I2Cx->CR1 &= ~(1 << 10); // disable ACK
	I2Cx->CR1 |= (1 << 9); //  Stop generation

	while(!(I2Cx->SR1 & (1 << 6)) ); // Stop RX
	data[size-1] = I2Cx->DR;
}

void I2Cx_Write(I2C_TypeDef *I2Cx, uint8_t addrSlave, uint8_t addrReg, uint8_t* data, uint8_t size) {
	I2Cx->CR1 |= (1 << 8) | (1 << 10); // ACK enable + Start generation
	while(!(I2Cx->SR1 & (1 << 0))); // Start generation

	I2Cx->DR = (addrSlave << 1) | 0;
	while(!(I2Cx->SR1 & (1 << 1)) | !(I2Cx->SR2 & (1 << 1))); // End of address transmission

	I2Cx->DR = addrReg;
	while(!(I2Cx->SR1 & (1 << 7))); // TxE : Data register empty (transmitters)

	if (size > 0) {
		for(int i=0; i < size; i++) {
			I2Cx->DR = data[i];
			while(!(I2Cx->SR1 & (1 << 7))); // RxE
		}
	}

	I2Cx->CR1 &= ~(1 << 10); // disable ACK
	I2Cx->CR1 |= (1 << 9); //  Stop generation
//	while(!(I2Cx->SR1 & (1 << 4)) ); // Stop generation

}

